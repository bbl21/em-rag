EM_RAG_PROJECT_ROOT=/app
EM_RAG_HOST=0.0.0.0
EM_RAG_PORT=8000
EM_RAG_RETRIEVAL_MODE=hybrid
EM_RAG_DEFAULT_TOP_K=8
EM_RAG_MAX_TOP_K=50

# Optional OpenAI-compatible answer provider. Retrieval works without these.
EM_RAG_OPENAI_BASE_URL=
EM_RAG_OPENAI_API_KEY=
EM_RAG_OPENAI_MODEL=
EM_RAG_PROVIDER_TIMEOUT_SECONDS=30

# Vector execution is required for product readiness and remains timeout isolated.
EM_RAG_ENABLE_VECTOR=1
EM_RAG_VECTOR_TIMEOUT_SECONDS=45
EM_RAG_EMBEDDING_BACKEND=local_cpu
EM_RAG_LOCAL_EMBEDDING_MODEL=/opt/em-rag-model
HF_HOME=/opt/em-rag-models
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# Optional OpenAI-compatible Embeddings API backend. It must return 384-dimensional
# embeddings compatible with the selected FAISS index.
EM_RAG_EMBEDDINGS_BASE_URL=
EM_RAG_EMBEDDINGS_API_KEY=
EM_RAG_EMBEDDINGS_MODEL=
# Required with the API backend so build and query use the same immutable model version.
EM_RAG_EMBEDDINGS_MODEL_REVISION=
EM_RAG_EMBEDDINGS_TIMEOUT_SECONDS=30
